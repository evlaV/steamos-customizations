# Create the swap file if it doesn't exist.
# Prior to repair image 20260618.10-3.8.10, there was a service ordering
# problem where the swap file might have been created before the home
# partition was resized, resulting in a broken swap file
# ("swapon: /home/swapfile: skipping - it appears to have holes").
# Check for a faulty swap file and forcefully re-create it.

if [[ "$#" -ne 2 ]]; then
    echo "Usage: $0 /path/to/swapfile size" >&2
    exit 2
fi

SWAPFILE="$1"
SIZE="$2"

create_swap_file() {
    @sbindir@/mkswap --file "${SWAPFILE}" --size "${SIZE}"
}

if ! stat -t "${SWAPFILE}" &> /dev/null; then
    # the file doesn't exist, it needs to be created
    echo "${SWAPFILE} doesn't exist, creating it" >&2
    create_swap_file
    exit $?
fi

# replicate the test in swapon (https://github.com/util-linux/util-linux/blob/f9baae0/sys-utils/swapon.c#L564-L572):
# if the number of blocks multiplied by the block size is less than the total
# size of the file, then it is sparse ("the file appears to have holes") 
if [[ $(( $(stat -c '%b * %B - %s' "${SWAPFILE}") )) -lt 0 ]]; then
    # the file is sparse, it needs to be deleted and re-created
    echo "${SWAPFILE} has holes, re-creating" >&2
    rm -f "${SWAPFILE}"
    create_swap_file
    exit $?
fi
