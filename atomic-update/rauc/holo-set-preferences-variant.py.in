#
# Set the Variant key in the [Choices] section of an atomupd
# preferences.conf file, creating the section if it's missing.
#
# Usage: holo-set-preferences-variant.py <path> <variant>

import os
import sys

import gi
gi.require_version('GLib', '2.0')
from gi.repository import GLib


def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <path> <variant>", file=sys.stderr)
        return 1

    path, variant = sys.argv[1], sys.argv[2]

    if not os.path.isfile(path):
        return 0

    keyfile = GLib.KeyFile.new()
    try:
        keyfile.load_from_file(path, GLib.KeyFileFlags.KEEP_COMMENTS)
    except GLib.Error as e:
        print(f"Failed to parse '{path}': {e}", file=sys.stderr)
        return 1

    keyfile.set_string("Choices", "Variant", variant)

    try:
        keyfile.save_to_file(path)
    except GLib.Error as e:
        print(f"Failed to save '{path}': {e}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
